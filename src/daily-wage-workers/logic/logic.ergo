namespace org.accordproject.dailywage

import org.accordproject.money.*

/**
 * Daily Wage Workers Payment Contract
 * Calculates total payment based on days worked and overtime hours
 */
contract DailyWage over DailyWageContract {
  
  /**
   * Calculate the total payment owed to the worker
   * @param request - contains daysWorked and overtimeHours
   * @return PaymentResponse with total amount and breakdown
   */
  clause calculatePayment(request : PaymentRequest) : PaymentResponse {
    
    // Calculate base payment (days × daily rate)
    let basePay = integerToDouble(request.daysWorked) * contract.dailyRate.doubleValue;
    
    // Calculate overtime payment (hours × overtime rate)
    let overtimePay = request.overtimeHours * contract.overtimeRate.doubleValue;
    
    // Total payment
    let total = basePay + overtimePay;
    
    return PaymentResponse{
      totalAmount: MonetaryAmount{
        doubleValue: total,
        currencyCode: contract.dailyRate.currencyCode
      },
      breakdown: "Base pay plus overtime"
    }
  }
}
