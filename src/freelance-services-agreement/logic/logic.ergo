namespace org.accordproject.freelanceservicesagreement

import org.accordproject.runtime.*
import org.accordproject.obligation.*
import org.accordproject.payment.PaymentReceived

contract FreelanceServicesAgreementContract over FreelanceServicesAgreementTemplate state FreelanceServicesAgreementState {

  clause init(request : Request) : Response {
    set state FreelanceServicesAgreementState {
      status: INITIALIZED
    };
    return Response{}
  }

  clause workCompleted(request : WorkCompleted) : Response emits PaymentObligation {
    enforce (state.status = INITIALIZED)
      else throw Error{ message: "Work completion has already been notified." };

    emit PaymentObligation{
      contract: contract,
      promisor: some(contract.client),
      promisee: some(contract.provider),
      deadline: none,
      amount: contract.paymentAmount,
      description: toString(contract.client) ++ " should pay " ++ toString(contract.provider) ++ " within " ++ toString(contract.paymentDueDays) ++ " days"
    };

    set state.status = PAYMENT_DUE;

    return Response{}
  }

  clause paymentReceived(request : PaymentReceived) : Response {
    enforce (state.status = PAYMENT_DUE)
      else throw Error{ message: "Payment can only be recorded when a payment obligation is due. Either no payment obligation has been emitted yet or the agreement has already been completed." };

    set state.status = COMPLETED;

    return Response{}
  }
}
