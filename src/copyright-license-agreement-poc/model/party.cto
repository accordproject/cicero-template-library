/*
 * PROTOTYPE model.
 *
 * A local stand-in for the `party@1.0.0` namespace proposed in
 * accordproject/models#200 ("Agreement 1.0 Model Redesign"):
 * https://github.com/accordproject/models/pull/200
 *
 * That PR is explicitly "a design target, not migration-ready" and is
 * not yet published to models.accordproject.org, so this file is a
 * hand-vendored subset used only by this prototype template. Delete it
 * and import the real `org.accordproject.party@1.0.0` namespace once
 * that PR lands.
 */

namespace poc.accordproject.party@0.1.0

/*
 * A single, unified representation of a contracting party. Replaces
 * the old pattern of each template declaring its own one-off party
 * fields (e.g. copyright-license's separate `licensee`/`licenseeState`/
 * `licenseeEntityType`/`licenseeAddress` string fields, duplicated a
 * second time for `licensor`).
 */
concept Party identified by partyId {
  o String partyId

  o String name
  o String role optional
  o String entityType optional
  o String state optional
  o String address optional
}
