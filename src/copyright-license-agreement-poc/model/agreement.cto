/*
 * PROTOTYPE model.
 *
 * A local stand-in for the `agreement@1.0.0` namespace proposed in
 * accordproject/models#200 ("Agreement 1.0 Model Redesign"):
 * https://github.com/accordproject/models/pull/200
 *
 * That PR is explicitly "a design target, not migration-ready" and is
 * not yet published to models.accordproject.org, so this file is a
 * hand-vendored subset covering only what this prototype template
 * needs. Delete it and import the real `org.accordproject.agreement@1.0.0`
 * namespace once that PR lands.
 */

namespace poc.accordproject.agreement@0.1.0

import poc.accordproject.party@0.1.0.Party

/*
 * Extension point for a template's own variables. A template now
 * *composes* one of these into an AgreementDocument, instead of
 * carrying its variables by subclassing the agreement envelope (the
 * old `TemplateModel extends Contract` / `extends Clause` pattern).
 */
abstract concept TemplateData {
}

/*
 * Extension point for a single clause's own variables -- the
 * composition-based replacement for a clause type that subclasses a
 * shared `Clause` base (e.g. the old `PaymentClause extends Clause`).
 */
abstract concept ClauseData {
}

/*
 * A single instantiated clause, addressable by its TemplateMark
 * instance path (e.g. "paymentTerms", or "deliveries[2].payment" for a
 * clause nested inside a repeating structure) rather than by a fixed,
 * statically-typed field on the envelope.
 */
concept Clause {
  o String path
  o ClauseData data
}

/*
 * Clause instances for one document, keyed by instance path. This is
 * the data-driven replacement for subclassing per nested-clause type:
 * which clauses exist, and in what shape, is determined by what's in
 * the map at runtime, not by the document's static type hierarchy.
 *
 * Tooling note: as of this prototype, @accordproject/markdown-template
 * cannot bind a `{{#clause}}` grammar block to a Map entry at all --
 * ClauseDefinition/WithDefinition resolution looks properties up via
 * ClassDeclaration#getOwnProperty (see TypeVisitor.js), which only
 * inspects properties declared *directly* on the @template class and
 * never walks the supertype chain. That's a stricter problem than "no
 * map support": it means nothing reachable only through inheritance or
 * composition renders, whether it's this Map or a plain composed field.
 * See model/model.cto and test/render.test.mjs's `expectedFailures` for
 * how that plays out for this template. This gap is consistent with PR
 * #200 being flagged "a design target, not migration-ready": the model
 * shape can be expressed today (Concerto 4 map support), but
 * cicero-core/template-engine need to catch up before a template can
 * rely on it end-to-end for grammar rendering. This prototype populates
 * `clauses` as a faithful data-layer example anyway -- it compiles,
 * round-trips through the serializer, and is what template logic reads
 * (see logic/logic.ts) even though the grammar can't reach it yet.
 */
map Clauses {
  o String
  o Clause
}

/*
 * One instrument within an Agreement (e.g. a master agreement, a
 * schedule, an annex). Carries the template's composed data, its
 * clause map, and the subset of the agreement's parties relevant to
 * this document.
 */
concept AgreementDocument {
  o String documentId
  o TemplateData data
  o Clauses clauses
  o Party[] parties optional
}
