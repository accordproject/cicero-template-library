/*
 * PROTOTYPE model.
 *
 * A local stand-in for the `agreement@1.0.0` namespace proposed in
 * accordproject/models#200 ("Agreement 1.0 Model Redesign"):
 * https://github.com/accordproject/models/pull/200
 *
 * That PR is explicitly "a design target, not migration-ready" and is
 * not yet published to models.accordproject.org, so this file is a
 * hand-vendored subset covering only what this prototype template
 * needs. Delete it and import the real `org.accordproject.agreement@1.0.0`
 * namespace once that PR lands.
 *
 * PROPOSED divergence ("design B"): an agreement document is a single tree
 * of template instances. models#200 instead gives a document a `data`
 * value plus a separate `clauses` map of composed archives, and keeps
 * clause state in a third, parallel structure (runtime@1.0.0
 * `clauseStates`). Here one `TemplateInstance` tree records which template
 * runs where and with what data; runtime state is a flat index keyed by
 * the same `instanceId`s (model/runtime.cto), so no structure is
 * maintained twice.
 */

namespace poc.accordproject.agreement@0.1.0

import poc.accordproject.party@0.1.0.Party
import poc.accordproject.templatedata@0.1.0.TemplateData

/*
 * One party's role within an agreement, resolved through the party
 * registry (see model/party.cto's `Party`). Unlike template data's
 * `PartyRef` (model/party.cto), a registry genuinely exists at this
 * envelope layer, so a real Concerto relationship is the right tool
 * here.
 */
concept AgreementParty {
  o String role optional
  --> Party party
}

/*
 * Which template an instance runs. A subset of models#200's
 * `template@1.0.0.TemplateReference`; its required `archiveHash` is
 * omitted because `crypto@1.0.0.ContentHash` isn't vendored.
 */
concept TemplateReference {
  o String templateId
  o String version
}

/*
 * The composed clauses of a template instance, keyed by instance path
 * within that instance's grammar (e.g. "latePayment").
 */
map Children {
  o String
  o TemplateInstance
}

/*
 * PROPOSED. One running template: a document's root template, or a
 * composed clause within it.
 *
 * - `instanceId` is stable across agreement revisions and unique within
 *   the agreement. It keys this instance's state in
 *   runtime.AgreementState.states, so the state index never mirrors the
 *   tree's shape.
 * - `data` is this template's own `TemplateData` subtype. An inline clause
 *   is a subtree of it, as in models#200; a composed clause is not, and
 *   its data lives on its own node under `children`. A parent's model
 *   therefore declares nothing about the clauses composed into it.
 * - `data` is typed abstractly, but only the generic runtime handles it
 *   at that type: each template's logic receives its own data at its own
 *   concrete type, as with models#200's `AgreementDocument.data`.
 */
concept TemplateInstance {
  o String instanceId
  o TemplateReference template
  o TemplateData data
  o Children children optional
}

/*
 * One instrument within an Agreement (e.g. a master agreement, a
 * schedule, an annex): a tree of template instances rooted at `root`,
 * plus the subset of the agreement's parties it binds.
 */
concept AgreementDocument {
  o String documentId
  o TemplateInstance root
  o AgreementParty[] parties optional
}

/*
 * Portable provenance for records that travel without the agreement, such
 * as obligations (model/obligation.cto). `clausePath` is the clause
 * instance path the record arises from, which is only unique within a
 * document, hence `documentId`. The real namespace's optional
 * `agreementHash`, `template` and `clauseHash` are omitted because their
 * types aren't vendored.
 *
 * Template logic sees only its data, never the agreement, so it sets just
 * `clausePath` and the runtime back-fills `agreementId` and `documentId`
 * from the envelope it owns (see logic/logic.ts).
 */
concept AgreementReference {
  o String agreementId
  o String documentId optional
  o String clausePath optional
}

/*
 * The top-level agreement: its documents in reading order, plus the
 * parties to the agreement as a whole. Identified, as in the real
 * namespace, so that model/runtime.cto's `AgreementState` can hold a
 * relationship to it. Documents are contained rather than related here so
 * that an agreement is one portable JSON value.
 */
asset Agreement identified by agreementId {
  o String agreementId
  o AgreementDocument[] documents
  o AgreementParty[] parties optional
}
