/*
 * PROTOTYPE model.
 *
 * A local stand-in for the `agreement@1.0.0` namespace proposed in
 * accordproject/models#200 ("Agreement 1.0 Model Redesign"):
 * https://github.com/accordproject/models/pull/200
 *
 * That PR is explicitly "a design target, not migration-ready" and is
 * not yet published to models.accordproject.org, so this file is a
 * hand-vendored subset covering only what this prototype template
 * needs. Delete it and import the real `org.accordproject.agreement@1.0.0`
 * namespace once that PR lands.
 */

namespace poc.accordproject.agreement@0.1.0

import poc.accordproject.party@0.1.0.Party
import poc.accordproject.templatedata@0.1.0.TemplateData

/*
 * One party's role within an agreement, resolved through the party
 * registry (see model/party.cto's `Party`). Unlike template data's
 * `PartyRef` (model/party.cto), a registry genuinely exists at this
 * envelope layer, so a real Concerto relationship is the right tool
 * here.
 */
concept AgreementParty {
  o String role optional
  --> Party party
}

/*
 * One instrument within an Agreement (e.g. a master agreement, a
 * schedule, an annex). Carries a template's composed data and the
 * subset of the agreement's parties relevant to this document.
 *
 * `copyright-license-agreement-poc` has no composed sub-template
 * archives, so its own template model (model/model.cto's
 * `CopyrightLicenseData`) *is* the renderable root directly -- it is
 * never wrapped in an `AgreementDocument`, and this prototype's
 * model.cto does not import this concept. It's vendored here purely to
 * document the wider envelope a runtime composing multiple documents
 * together would use.
 *
 * Where a document *does* compose one or more sub-template archives,
 * each instance would be addressed through a `clauses` map keyed by its
 * TemplateMark instance path (e.g. "paymentTerms", rooted at the
 * document's data -- never prefixed with "data."), holding a `Clause {
 * template: TemplateReference, clauseId optional, clauseHash optional }`
 * pointing at the composed archive (see the `template@1.0.0` and
 * `agreement@1.0.0` namespaces in accordproject/models#200 for that
 * full shape -- note `Clause.path` has been removed there: the instance
 * path now lives only as the map key). That `clauses` map is omitted
 * from this vendored subset entirely, because this prototype's
 * `PaymentTerms` (model/model.cto) is an ordinary nested concept, not a
 * composed sub-template archive -- no `clauses` entry is ever
 * populated, or would even have anywhere authoritative to point.
 */
concept AgreementDocument {
  o String documentId
  o TemplateData data
  o AgreementParty[] parties optional
}

/*
 * A reference to one document within an agreement, e.g. for
 * cross-referencing between composed documents. Vendored for parity
 * with the real namespace; unused by this prototype.
 */
concept AgreementReference {
  o String agreementId
  o String documentId
}

/*
 * The top-level agreement: a collection of documents plus the parties
 * to the agreement as a whole. Vendored for parity with the real
 * namespace; unused by this prototype.
 */
concept Agreement {
  o String agreementId
  o AgreementDocument[] documents
  o AgreementParty[] parties optional
}
