/*
 * PROTOTYPE model.
 *
 * A local stand-in for the `runtime@1.0.0` namespace proposed in
 * accordproject/models#200 ("Agreement 1.0 Model Redesign"):
 * https://github.com/accordproject/models/pull/200
 *
 * That PR is explicitly "a design target, not migration-ready" and is
 * not yet published to models.accordproject.org, so this file is a
 * hand-vendored subset covering only what this prototype template
 * needs. Delete it and import the real `org.accordproject.runtime@1.0.0`
 * namespace once that PR lands.
 *
 * Omitted from this subset: `stateHash` / `previousStateHash` (they need
 * the unvendored `crypto@1.0.0.ContentHash`, and their canonicalization
 * is left to a profile anyway), and runtime@1.0.0's own `Request` /
 * `Response` (this template still extends the published
 * `org.accordproject.runtime@0.2.0` ones, which is what today's
 * template-engine checks requests and responses against).
 *
 * PROPOSED divergence ("design B"): state is one flat index keyed by
 * template instance, replacing models#200's `data` + `clauseStates`.
 */

namespace poc.accordproject.runtime@0.1.0

import poc.accordproject.agreement@0.1.0.Agreement
import poc.accordproject.templatedata@0.1.0.StateData

/*
 * PROPOSED. The state of each stateful template instance in the
 * agreement, keyed by `agreement.TemplateInstance.instanceId`. Each value
 * is that instance's template's own `StateData` subtype; an inline
 * clause's state is a subtree of it. Keys are stable ids, not paths, so
 * the index has no shape to keep in step with the instance tree: adding,
 * removing or reordering instances only adds or removes entries. A
 * stateless instance has no entry.
 */
map InstanceStates {
  o String
  o StateData
}

/*
 * The runtime's identified, revisioned snapshot of an agreement's state.
 *
 * Template logic never sees this envelope: `init()` and `trigger()` take
 * and return only their own template's `StateData` subtype, and the
 * runtime owns `stateId`, `revision` and `effectiveAt`. A transition that
 * changes several instances -- a document and the clauses composed into
 * it -- is committed as one revision (see agreement/host.ts).
 */
asset AgreementState identified by stateId {
  o String stateId
  --> Agreement agreement
  o Long revision default=0 range=[0,]
  o DateTime effectiveAt
  o InstanceStates states optional
}
