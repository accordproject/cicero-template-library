/*
 * PROPOSED additions to accordproject/models#200 ("Agreement 1.0 Model
 * Redesign"), for executable composed clauses ("design B" in the README).
 *
 * Everything else this prototype uses is models#200's own 1.0.0
 * namespaces, vendored verbatim (model/@models.accordproject.org.*). This
 * namespace holds only what design B adds or changes, each as a subtype
 * of the models#200 type it would change, so the delta is reviewable in
 * one place. Were it adopted, each subtype's fields would move into its
 * base type and this namespace would disappear.
 *
 * The types have names of their own, rather than repeating the base
 * type's, because Concerto's TypeScript codegen emits duplicate imports
 * for two loaded types with the same short name.
 */

concerto version "^5.0.0"

namespace poc.accordproject.composition@0.1.0

import org.accordproject.templatedata@1.0.0.{TemplateData, StateData}
import org.accordproject.agreement@1.0.0.{Clause, Clauses, AgreementReference}
import org.accordproject.runtime@1.0.0.AgreementState
import org.accordproject.obligation@1.0.0.Obligation

/*
 * PROPOSED change to agreement@1.0.0.Clause: a composed clause carries its
 * own data and its own composed clauses, so an AgreementDocument is one
 * tree of template instances. The document is the root instance (its
 * `template` and `data`); each clause in its `clauses` map, keyed by the
 * clause's path within the parent's grammar, is a child instance.
 *
 * - An inline clause is a subtree of its template's `data`, as in
 *   models#200. A composed clause is not: its data lives here, so a
 *   parent's model declares nothing about the clauses composed into it.
 * - `clauseId` (optional on Clause) is required by this design: it is the
 *   clause's stable instance id, keying its state in
 *   `IndexedAgreementState.states`. A document's instance id is its
 *   `documentId`.
 */
concept ComposedClause extends Clause {
  o TemplateData data
  o Clauses clauses optional
}

/*
 * PROPOSED replacement for runtime@1.0.0.AgreementState's `data` and
 * `clauseStates`: one flat index of every stateful instance's state,
 * keyed by instance id (a document's `documentId`, a clause's
 * `clauseId`). Keys are stable ids, so the index never mirrors the tree's
 * shape, and a stateless instance has no entry. Under this proposal
 * `data` and `clauseStates` are left unset.
 */
map InstanceStates {
  o String
  o StateData
}

asset IndexedAgreementState extends AgreementState {
  o InstanceStates states optional
}

/*
 * PROPOSED change to agreement@1.0.0.AgreementReference: the document the
 * referenced clause is in. `clausePath` is only unique within a document,
 * so without it a reference into a multi-document agreement is ambiguous.
 */
concept DocumentReference extends AgreementReference {
  o String documentId
}

/*
 * PROPOSED addition to obligation@1.0.0: issuing an obligation is an event
 * logic emits, like ObligationTransition, rather than a record logic
 * writes. The obligation registry applies both.
 */
event ObligationIssued {
  o Obligation obligation
}
